{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "vitest": ["../../plugins/vitest/node_modules/vitest"]
    },
    "typeRoots": ["../../plugins/vitest/node_modules/@types"]
  },
  "include": ["*.ts"]
}
